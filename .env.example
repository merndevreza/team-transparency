NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-only — bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
